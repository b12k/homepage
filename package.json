{
  "name": "@b12k/homepage",
  "version": "0.0.0",
  "private": true,
  "repository": "https://github.com/b12k/homepage",
  "license": "MIT",
  "author": "Bogdan Kolesnyk",
  "scripts": {
    "🚀": "████████████████████████ ✋ SCRIPTS 👇 ████████████████████████████",
    "prepare": "husky",
    "prepare:env": "shx cp -u .env.example .env",
    "prepare:husky": "husky init",
    "dev": "run-p dev:*",
    "dev:client": "run-p dev:client:*",
    "dev:client:browser": "env-cmd rspack serve -c rspack/config.browser.ts",
    "dev:client:server": "env-cmd rspack build -c rspack/config.server.ts",
    "dev:server": "run-s dev:server:*",
    "dev:server:wait": "env-cmd -i wait-on http://localhost:{{WDS_PORT}}/public/manifest.json",
    "dev:server:run": "nodemon",
    "dev:public": "pnpm build:public --watch",
    "dev:docker-compose": "docker compose up -d",
    "check": "run-p check:*",
    "check:format": "pnpm _prettier -c .",
    "check:types": "pnpm _tsc",
    "check:styles": "pnpm _stylelint \"**/*.{css,scss,vue}\"",
    "check:scripts": "pnpm _eslint .",
    "check:templates": "pnpm _djlint . --check",
    "fix": "run-p fix:*",
    "fix:format": "pnpm _prettier -w .",
    "fix:styles": "pnpm check:styles --fix",
    "fix:scripts": "pnpm check:scripts --fix",
    "// fix:templates": "pnpm _djlint . --reformat",
    "deps:check": "",
    "deps:upgrade": "ncu -du --doctorInstall \"pnpm i\" --doctorTest \"pnpm deps:upgrade:doctor\"",
    "deps:upgrade:doctor": "run-p check:types check:styles check:scripts build",
    "clean": "shx rm -rf dist",
    "build": "pnpm clean && run-p build:*",
    "build:client": "run-p build:client:*",
    "build:client:browser": "rspack build -c rspack/config.browser.ts",
    "build:client:ssr": "rspack build -c rspack/config.server.ts",
    "build:server": "swc ./src/server -d ./dist --copy-files --strip-leading-paths --config-file server.swcrc",
    "build:public": "swc ./src/public -d ./dist --copy-files --strip-leading-paths --config-file public.swcrc",
    "stats": "cross-env WITH_STATS=true pnpm build && serve ./dist/bundle-stats.html",
    "start": "node dist/server",
    "start:local": "nodemon --watch src --watch .env --ext * --exec \"pnpm build && cross-env NODE_ENV=production env-cmd -n node ./dist/server\"",
    "start:docker": "env-cmd -i docker run --env-file .env.docker -p 80:8080 -d {{DOCKER_IMAGE}}-amd64-latest",
    "docker:build": "env-cmd -i pnpm _docker-build --cache-from={{DOCKER_IMAGE}}-amd64-latest -t {{DOCKER_IMAGE}}-amd64-latest",
    "docker:build:arm": "env-cmd -i pnpm _docker-build --cache-from={{DOCKER_IMAGE}}-arm64-latest -t {{DOCKER_IMAGE}}-arm64-latest --platform linux/arm64",
    "deploy": "env-cmd -i curl -X POST {{PORTAINER_WEBHOOK}}",
    "🛠️": "████████████████████████ ✋ PRE-CONFIGURED 👇 █████████████████████",
    "_tsc": "vue-tsc --noEmit -p tsconfig.json",
    "_eslint": "eslint",
    "_djlint": "djlint --profile=nunjucks --extension=njk --indent=2 --indent-css=2 --indent-js=2 --use-gitignore",
    "_prettier": "prettier --ignore-unknown",
    "_stylelint": "stylelint --ignore-path=.gitignore",
    "_docker-build": "cross-env DOCKER_BUILDKIT=1 docker buildx build . --build-arg BUILDKIT_INLINE_CACHE=1 --push",
    "_sort-package-json": "sort-package-json",
    "🪝": "████████████████████████ ✋ GIT HOOKS 👇 ██████████████████████████",
    "husky:commit-msg": "commitlint",
    "husky:pre-commit": "lint-staged",
    "husky:pre-push": "branch-name-lint"
  },
  "dependencies": {
    "@b12k/vue3-router-gmc": "0.1.3",
    "@nitedani/shrink-ray-current": "4.3.0",
    "@popperjs/core": "2.11.8",
    "@unhead/ssr": "1.11.20",
    "@unhead/vue": "1.11.20",
    "animate.css": "4.1.1",
    "axios": "1.8.4",
    "bootstrap": "5.3.3",
    "cookie-parser": "1.4.7",
    "decache": "4.6.2",
    "deep-object-diff": "1.1.9",
    "express": "4.21.2",
    "helmet": "8.1.0",
    "js-cookie": "3.0.5",
    "lodash": "4.17.21",
    "lru-cache": "11.0.2",
    "nunjucks": "3.2.4",
    "path-to-regexp": "8.2.0",
    "pinia": "3.0.1",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "pino-pretty": "13.0.0",
    "purgecss": "7.0.2",
    "redis": "4.7.0",
    "safe-stable-stringify": "2.5.0",
    "serve-favicon": "2.5.0",
    "surenv": "1.1.0",
    "ua-parser-js": "2.0.3",
    "vue": "3.5.13",
    "vue-router": "4.5.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@b12k/branch-name-lint": "1.1.0",
    "@b12k/env-cmd": "10.2.0",
    "@commitlint/config-conventional": "19.8.0",
    "@eslint/config-inspector": "1.0.2",
    "@eslint/js": "9.22.0",
    "@rspack/cli": "1.2.8",
    "@rspack/core": "1.2.8",
    "@swc-node/register": "1.10.10",
    "@swc/cli": "0.6.0",
    "@swc/core": "1.11.11",
    "@swc/helpers": "0.5.15",
    "@types/bootstrap": "5.2.10",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.1",
    "@types/express-pino-logger": "4.0.5",
    "@types/js-cookie": "3.0.6",
    "@types/lodash": "4.17.16",
    "@types/node": "22.13.10",
    "@types/nunjucks": "3.2.6",
    "@types/serve-favicon": "2.5.7",
    "@types/ua-parser-js": "0.7.39",
    "@typescript-eslint/parser": "8.27.0",
    "@vue/language-server": "2.2.8",
    "autoprefixer": "10.4.21",
    "bundle-stats-webpack-plugin": "4.19.0",
    "chokidar": "4.0.3",
    "commitlint": "19.8.0",
    "cross-env": "7.0.3",
    "css-loader": "7.1.2",
    "djlint": "1.36.4",
    "eslint": "9.22.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-import-resolver-typescript": "4.2.2",
    "eslint-plugin-import-x": "4.9.1",
    "eslint-plugin-perfectionist": "4.10.1",
    "eslint-plugin-prettier": "5.2.3",
    "eslint-plugin-unicorn": "57.0.0",
    "eslint-plugin-vue": "10.0.0",
    "file-loader": "6.2.0",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "ignore-loader": "0.1.2",
    "lint-staged": "15.5.0",
    "nodemon": "3.1.9",
    "npm-check-updates": "17.1.15",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.3",
    "postcss-html": "1.8.0",
    "postcss-loader": "8.1.1",
    "prettier": "3.5.3",
    "prettier-plugin-jinja-template": "2.0.0",
    "rspack-manifest-plugin": "5.0.3",
    "sass": "1.86.0",
    "sass-loader": "16.0.5",
    "serve": "14.2.4",
    "shx": "0.4.0",
    "sort-package-json": "3.0.0",
    "stylelint": "16.16.0",
    "stylelint-config-prettier-scss": "1.0.0",
    "stylelint-config-recommended-vue": "1.6.0",
    "stylelint-config-standard-scss": "14.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.2",
    "typescript-eslint": "8.27.0",
    "url-loader": "4.1.1",
    "vue-loader": "17.4.2",
    "vue-style-loader": "4.1.3",
    "vue-tsc": "2.2.8",
    "wait-on": "8.0.3"
  },
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": "22"
  }
}
