{
  "name": "@b12k/homepage",
  "author": "Bogdan Kolesnyk",
  "repository": "https://github.com/b12k/homepage",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "packageManager": "pnpm@10.5.1",
  "scripts": {
    "dev": "run-s _clean _dev",
    "qc": "run-p _qc:*",
    "_qc:typecheck": "vue-tsc --noEmit",
    "__qc:prettier": "pnpm _prettier -c .",
    "_qc:stylelint": "stylelint \"**/*.{css,scss,vue}\" --ignore-path .gitignore",
    "_qc:eslint": "eslint .",
    "fix": "run-p _fix:*",
    "_fix:prettier": "pnpm _prettier -w .",
    "_fix:stylelint": "pnpm _qc:stylelint --fix",
    "_fix:eslint": "pnpm _qc:eslint --fix",
    "upgrade:deps": "ncu -du --doctorInstall \"pnpm i\" --doctorTest \"pnpm upgrade:deps:doctor\"",
		"upgrade:deps:doctor": "run-p qc build",
    "build": "run-s _clean _build",
    "build:docker:base": "cross-env DOCKER_BUILDKIT=1 docker buildx build . --build-arg BUILDKIT_INLINE_CACHE=1 --push",
    "build:docker:amd": "env-cmd -i pnpm build:docker:base --cache-from={{DOCKER_IMAGE}}-amd64-latest -t {{DOCKER_IMAGE}}-amd64-latest",
    "build:docker:arm": "run-s build:docker:arm:*",
    "build:docker:arm:build": "env-cmd -i pnpm build:docker:base --cache-from={{DOCKER_IMAGE}}-arm64-latest -t {{DOCKER_IMAGE}}-arm64-latest --platform linux/arm64",
    "build:docker:arm:deploy": "env-cmd -i curl -X POST {{PORTAINER_WEBHOOK}}",
    "build:stats": "cross-env WITH_STATS=true pnpm build && serve ./dist/bundle-stats.html",
    "start": "node dist",
    "start:local": "nodemon --watch src --watch .env --ext * --exec \"pnpm build && cross-env NODE_ENV=production env-cmd --no-override node ./dist\"",
    "⚙️": "######################## TECHNICAL SCRIPTS ########################",
    "prepare": "husky",
    "_prepare:env": "shx cp -u .env.example .env",
    "_prepare:husky": "husky init",
    "_prettier": "prettier --ignore-unknown --ignore-path .gitignore",
    "_dev": "run-p _dev:*",
    "_dev:client": "run-p _dev:client:*",
    "_dev:client:browser": "env-cmd rspack serve -c rspack/config.browser.ts",
    "_dev:client:server": "env-cmd rspack build -c rspack/config.server.ts",
    "_dev:server": "run-s _dev:server:wait _dev:server:run",
    "_dev:server:wait": "env-cmd -i wait-on http://localhost:{{WDS_PORT}}/public/manifest.json",
    "_dev:server:run": "nodemon",
    "_dev:public": "pnpm _build:public --watch",
    "_dev:docker-compose": "docker compose up -d",
    "_clean": "rm -rf dist",
    "_build": "run-p _build:*",
    "_build:client": "run-p _build:client:*",
    "_build:client:browser": "rspack build -c rspack/config.browser.ts",
    "_build:client:ssr": "rspack build -c rspack/config.server.ts",
    "_build-wp": "run-p _build-wp:*",
    "_build-wp:client": "run-p _build-wp:client:*",
    "_build-wp:client:ssr": "webpack -c webpack/config.server.ts",
    "_build-wp:client:browser": "webpack -c webpack/config.browser.ts",
    "_build:server": "run-p _build:server:*",
    "_build:server:src": "swc ./src/server -d ./dist --copy-files --strip-leading-paths --config-file server.swcrc",
    "_build:server:entry": "swc ./src/index.ts -o ./dist/index.js --strip-leading-paths --config-file server.swcrc",
    "_build:public": "swc ./src/public -d ./dist --copy-files --strip-leading-paths --config-file public.swcrc",
    "🪝": "############################ GIT HOOKS ############################",
    "_git:commit-msg": "commitlint",
    "_git:pre-commit": "run-p _git:pre-commit:*",
    "_git:pre-commit:tsc": "pnpm _qc:typecheck",
    "_git:pre-commit:lint-staged": "lint-staged",
    "_git:pre-push": "branch-name-lint"
  },
  "devDependencies": {
    "@b12k/branch-name-lint": "1.1.0",
    "@b12k/env-cmd": "10.2.0",
    "@commitlint/config-conventional": "19.7.1",
    "@eslint/config-inspector": "1.0.0",
    "@eslint/js": "9.21.0",
    "@rspack/cli": "1.2.6",
    "@rspack/core": "1.2.6",
    "@swc-node/register": "1.10.9",
    "@swc/cli": "0.6.0",
    "@swc/core": "1.11.1",
    "@swc/helpers": "0.5.15",
    "@types/bootstrap": "5.2.10",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/express-pino-logger": "4.0.5",
    "@types/js-cookie": "3.0.6",
    "@types/lodash": "4.17.15",
    "@types/node": "22.13.5",
    "@types/nunjucks": "3.2.6",
    "@types/serve-favicon": "2.5.7",
    "@types/ua-parser-js": "0.7.39",
    "@vue/language-server": "2.2.4",
    "autoprefixer": "10.4.20",
    "chokidar": "4.0.3",
    "commitlint": "19.7.1",
    "cross-env": "7.0.3",
    "css-loader": "7.1.2",
    "eslint": "9.21.0",
    "eslint-config-prettier": "10.0.2",
    "eslint-import-resolver-typescript": "3.8.3",
    "eslint-plugin-import-x": "4.6.1",
    "eslint-plugin-perfectionist": "4.9.0",
    "eslint-plugin-prettier": "5.2.3",
    "eslint-plugin-unicorn": "57.0.0",
    "eslint-plugin-vue": "9.32.0",
    "file-loader": "6.2.0",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "ignore-loader": "0.1.2",
    "lint-staged": "15.4.3",
    "nodemon": "3.1.9",
    "npm-check-updates": "17.1.15",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.3",
    "postcss-html": "1.8.0",
    "postcss-loader": "8.1.1",
    "prettier": "3.5.2",
    "rspack-manifest-plugin": "5.0.3",
    "sass": "1.85.1",
    "sass-loader": "16.0.5",
    "shx": "0.3.4",
    "stylelint": "16.14.1",
    "stylelint-config-prettier-scss": "1.0.0",
    "stylelint-config-recommended-vue": "1.6.0",
    "stylelint-config-standard-scss": "14.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.25.0",
    "url-loader": "4.1.1",
    "vue-loader": "17.4.2",
    "vue-style-loader": "4.1.3",
    "vue-template-compiler": "2.7.16",
    "vue-tsc": "2.2.4",
    "wait-on": "8.0.2"
  },
  "dependencies": {
    "@b12k/vue3-router-gmc": "0.1.3",
    "@nitedani/shrink-ray-current": "4.3.0",
    "@popperjs/core": "2.11.8",
    "@unhead/ssr": "1.11.20",
    "@unhead/vue": "1.11.20",
    "animate.css": "4.1.1",
    "axios": "1.8.1",
    "bootstrap": "5.3.3",
    "cookie-parser": "1.4.7",
    "decache": "4.6.2",
    "deep-object-diff": "1.1.9",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "js-cookie": "3.0.5",
    "lodash": "4.17.21",
    "lru-cache": "11.0.2",
    "nunjucks": "3.2.4",
    "path-to-regexp": "8.2.0",
    "pinia": "3.0.1",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "purgecss": "7.0.2",
    "redis": "4.7.0",
    "safe-stable-stringify": "2.5.0",
    "serve-favicon": "2.5.0",
    "surenv": "1.1.0",
    "ua-parser-js": "2.0.2",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  }
}
