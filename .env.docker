###### Required ######
NODE_ENV=production
PORT=8080
ENABLE_DEBUG=please
SERVER_ENV=local
DEFAULT_LANGUAGE=en
ACCEPTED_LANGUAGES=de,en

###### Optional ######
DEBUG=false

LOG_LEVEL=info

REDIS_URL=redis://default:secret@host.docker.internal:6379

CACHE=true

RENDER_CACHE=true
RENDER_CACHE_TTL=600
RENDER_CACHE_SALT=123123

CRITICAL_CSS_CACHE=true
CRITICAL_CSS_CACHE_TTL=600
CRITICAL_CSS_CACHE_SALT=123123

###### Development ######
WDS_PORT=8081
REDIS_PORT=6379
REDIS_PASSWORD=secret
DOCKER_IMAGE=b12k/homepage:webapp
PORTAINER_WEBHOOK=
